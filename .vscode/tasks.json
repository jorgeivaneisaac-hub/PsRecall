{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cmake",
            "label": "CMake: Configure",
            "command": "configure",
            "options": {
                "env": {
                    "CC": "clang",
                    "CXX": "clang++"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "type": "cmake",
            "label": "CMake: Build (Release)",
            "command": "build",
            "targets": [
                "all"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [],
            "dependsOn": [
                "CMake: Configure"
            ]
        },
        {
            "type": "shell",
            "label": "Run Tests",
            "command": "${workspaceFolder}/build/tests/ignis_tests",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "dependsOn": [
                "CMake: Build (Release)"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
